#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${BILIDIGEST_HOME:-}" ]]; then
  repo_root="$BILIDIGEST_HOME"
else
  script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
  candidate="$(cd -- "$script_dir/../../.." && pwd)"
  if [[ -f "$candidate/tools/bilidigest.py" ]]; then
    repo_root="$candidate"
  elif command -v bilidigest >/dev/null 2>&1; then
    exec bilidigest "$@"
  else
    echo 'Install BiliDigest first, or set BILIDIGEST_HOME to its repository.' >&2
    exit 1
  fi
fi

if [[ ! -d "$repo_root" ]]; then
  echo "BiliDigest repo not found. Set BILIDIGEST_HOME to the cloned repository path." >&2
  exit 1
fi

if [[ -x "$repo_root/.venv/bin/python" ]]; then
  python_bin="$repo_root/.venv/bin/python"
else
  python_bin="${PYTHON:-python3}"
fi

cd "$repo_root"
exec "$python_bin" -m tools.bilidigest "$@"
