#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${BILISUBNOTES_HOME:-}" ]]; then
  repo_root="$BILISUBNOTES_HOME"
else
  repo_root="/Users/a15300/code/02-lab/BiliSubNotes"
fi

if [[ ! -d "$repo_root" ]]; then
  echo "BiliSubNotes repo not found. Set BILISUBNOTES_HOME to the cloned repository path." >&2
  exit 1
fi

if [[ -x "$repo_root/.venv/bin/python" ]]; then
  python_bin="$repo_root/.venv/bin/python"
else
  python_bin="${PYTHON:-python3}"
fi

cd "$repo_root"
exec "$python_bin" -m tools.bilisub "$@"
